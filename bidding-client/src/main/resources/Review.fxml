<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: #fce4ec;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.controller.ReviewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 18; -fx-border-color: #f8bbd0; -fx-border-radius: 18; -fx-border-width: 1.5;">
                    <children>
                        <StackPane prefHeight="70.0" prefWidth="70.0">
                            <children>
                                <Circle fill="#ffe4ec" radius="35.0" stroke="#ffb3cc" strokeType="INSIDE" />
                                <Label text="🏪" style="-fx-font-size: 32px;" />
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label text="Pink Shop" textFill="#880e4f">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <children>
                                        <Label text="4.8" textFill="#c2185b" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                                        <Label text="⭐⭐⭐⭐★" textFill="#ffb300" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>
                                <Label text="(128 đánh giá)" textFill="#888888">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="150.0" style="-fx-background-color: #fdf2f4; -fx-border-color: #ffb3cc; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10;">
                            <children>
                                <Label text="Đánh giá trung bình" textFill="#880e4f">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="2.0">
                                    <children>
                                        <Label text="4.8" textFill="#c2185b">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label text=" / 5" textFill="#888888">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="reviewsContainer" spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 5 5 5 5;" />
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBackToAuctionList" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #fdf2f4; -fx-text-fill: #e91e63; -fx-border-color: #e91e63; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="📋 Danh sách đấu giá" />

                        <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #e91e63; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="📝 Thêm đánh giá" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
