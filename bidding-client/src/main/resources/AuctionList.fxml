<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.uet.bidding.controller.AuctionListController"
            prefHeight="600.0"
            prefWidth="900.0"
            stylesheets="@style.css">

    <children>

        <VBox alignment="TOP_CENTER"
              spacing="15.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">

            <children>

                <HBox alignment="CENTER"
                      prefWidth="860.0">

                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT"
                                      spacing="8.0">
                                    <children>
                                        <StackPane prefHeight="60.0"
                                                   prefWidth="60.0"
                                                   onMouseClicked="#handleGoToMyManagement"
                                                   style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#f26f8d"
                                                        radius="28.0"/>
                                                <Label text="B"
                                                       textFill="white">
                                                    <font>
                                                        <Font name="System Bold"
                                                              size="20.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Bidder"
                                               textFill="#555555">
                                            <font>
                                                <Font name="System Bold"
                                                      size="13.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="8.0">
                                    <children>
                                        <StackPane prefHeight="60.0"
                                                   prefWidth="60.0"
                                                   onMouseClicked="#handleGoToSellerDashboard"
                                                   style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#3b82f6"
                                                        radius="28.0"/>
                                                <Label text="S"
                                                       textFill="white">
                                                    <font>
                                                        <Font name="System Bold"
                                                              size="20.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Seller"
                                               textFill="#555555">
                                            <font>
                                                <Font name="System Bold"
                                                      size="13.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="DANH SÁCH ĐẤU GIÁ"
                               textFill="#1e3a8a">

                            <font>
                                <Font name="System Bold"
                                      size="30.0"/>
                            </font>

                        </Label>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER"
                              spacing="20.0">

                            <children>

                                <VBox alignment="CENTER"
                                      spacing="4.0"
                                      onMouseClicked="#handleGoToMyProfile"
                                      style="-fx-cursor: hand;">

                                    <children>

                                        <Circle fill="#e2e8f0"
                                                radius="20.0"
                                                stroke="#cbd5e1"
                                                strokeType="INSIDE"/>

                                        <Label text="Setting"
                                               textFill="#555555">

                                            <font>
                                                <Font name="System Bold"
                                                      size="12.0"/>
                                            </font>

                                        </Label>

                                    </children>

                                </VBox>

                                <Button mnemonicParsing="false"
                                        onAction="#handleLogout"
                                        text="Đăng xuất"
                                        style="-fx-background-color: #ef4444;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-pref-width: 110px;
                                               -fx-pref-height: 38px;">

                                    <font>
                                        <Font name="System Bold"
                                              size="13.0"/>
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </HBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="10.0">

                    <children>

                        <ComboBox fx:id="cityComboBox"
                                  prefHeight="42.0"
                                  prefWidth="300.0"
                                  promptText="Chọn Tỉnh/Thành phố..."
                                  style="-fx-background-radius: 8;
                                         -fx-border-radius: 8;"/>

                        <Button mnemonicParsing="false"
                                onAction="#handleSearch"
                                text="Tìm kiếm"
                                style="-fx-background-color: #f26f8d;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;
                                       -fx-pref-height: 42px;
                                       -fx-pref-width: 120px;">

                            <font>
                                <Font name="System Bold"
                                      size="14.0"/>
                            </font>

                        </Button>

                    </children>

                </HBox>

                <TableView fx:id="tableView"
                           prefHeight="320.0"
                           prefWidth="860.0">

                    <columns>

                        <TableColumn fx:id="colStt"
                                     text="STT"/>

                        <TableColumn fx:id="colCity"
                                     text="Thành Phố/Tỉnh"/>

                        <TableColumn fx:id="colProduct"
                                     text="Loại sản phẩm"/>

                        <TableColumn fx:id="colInterested"
                                     text="Số người quan tâm"/>

                        <TableColumn fx:id="colAction"
                                     text="Lựa chọn"/>

                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</AnchorPane>