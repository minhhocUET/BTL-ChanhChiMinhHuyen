<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.controller.AuctionListController">

    <children>

        <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <children>

                <HBox alignment="CENTER" prefWidth="860.0">

                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <StackPane onMouseClicked="#handleGoToMyManagement" prefHeight="60.0" prefWidth="60.0" style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#f26f8d" radius="28.0" />
                                                <Label text="B" textFill="white">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Bidder" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <StackPane onMouseClicked="#handleGoToSellerDashboard" prefHeight="60.0" prefWidth="60.0" style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#3b82f6" radius="28.0" />
                                                <Label text="S" textFill="white">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Seller" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="DANH SÁCH ĐẤU GIÁ" textFill="#1e3a8a">

                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>

                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="20.0">

                            <children>

                                <VBox alignment="CENTER" onMouseClicked="#handleGoToMyProfile" spacing="4.0" style="-fx-cursor: hand;">

                                    <children>

                                        <Circle fill="#e2e8f0" radius="20.0" stroke="#cbd5e1" strokeType="INSIDE" />

                                        <Label text="Setting" textFill="#555555">

                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>

                                        </Label>

                                    </children>

                                </VBox>

                                <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-width: 110px; -fx-pref-height: 38px;" text="Đăng xuất">

                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">

                    <children>

                        <ComboBox fx:id="cityComboBox" prefHeight="42.0" prefWidth="300.0" promptText="Chọn Tỉnh/Thành phố..." style="-fx-background-radius: 8; -fx-border-radius: 8;" />

                        <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-background-color: #f26f8d; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-height: 42px; -fx-pref-width: 120px;" text="Tìm kiếm">

                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>

                        </Button>

                    </children>

                </HBox>

                <TableView fx:id="tableView" prefWidth="860.0" VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colCity" prefWidth="130.0" minWidth="130.0" maxWidth="130.0" text="Thành phố" resizable="false" />

                        <TableColumn fx:id="colItemType" prefWidth="130.0" minWidth="130.0" maxWidth="130.0" text="Loại sản phẩm" resizable="false" />

                        <TableColumn fx:id="colProductName" prefWidth="290.0" text="Tên sản phẩm" resizable="false" />

                        <TableColumn fx:id="colRegistered" prefWidth="160.0" minWidth="160.0" maxWidth="160.0" text="Số người đăng ký" resizable="false" />

                        <TableColumn fx:id="colAction" prefWidth="150.0" minWidth="150.0" maxWidth="150.0" text="Thao tác" resizable="false" />
                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</AnchorPane>