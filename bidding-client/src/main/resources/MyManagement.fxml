<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ffe4e8;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.ui.MyManagementController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: white; -fx-border-color: #d8466b; -fx-border-radius: 5; -fx-cursor: hand;" text="← Quay lại" textFill="#d8466b">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>

                        <Region prefWidth="20.0" />

                        <Label text="QUẢN LÝ CỦA TÔI" textFill="#d8466b">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER" onMouseClicked="#handleGoToMyProfile" spacing="4.0" style="-fx-cursor: hand;">
                            <children>
                                <Circle fill="#e2e8f0" radius="20.0" stroke="#cbd5e1" strokeType="INSIDE" />
                                <Label text="My Profile" textFill="#555555">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <TabPane style="-fx-background-color: white; -fx-background-radius: 8;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>

                        <Tab text="Đang tham gia đấu giá">
                            <content>
                                <AnchorPane>
                                    <children>
                                        <TableView fx:id="bidTableView" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                            <columns>
                                                <TableColumn fx:id="colBidStt" prefWidth="50.0" text="STT" />
                                                <TableColumn fx:id="colBidName" prefWidth="250.0" text="Tên sản phẩm" />
                                                <TableColumn fx:id="colBidCurrentPrice" prefWidth="150.0" text="Giá hiện tại" />
                                                <TableColumn fx:id="colBidMyPrice" prefWidth="150.0" text="Giá đã đặt" />
                                                <TableColumn fx:id="colBidStatus" prefWidth="150.0" text="Trạng thái" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>

                        <Tab text="Sản phẩm đang giao bán">
                            <content>
                                <AnchorPane>
                                    <children>
                                        <TableView fx:id="sellTableView" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                            <columns>
                                                <TableColumn fx:id="colSellStt" prefWidth="50.0" text="STT" />
                                                <TableColumn fx:id="colSellName" prefWidth="250.0" text="Tên sản phẩm" />
                                                <TableColumn fx:id="colSellStartPrice" prefWidth="150.0" text="Giá khởi điểm" />
                                                <TableColumn fx:id="colSellHighestBid" prefWidth="150.0" text="Giá đang trả cao nhất" />
                                                <TableColumn fx:id="colSellInterested" prefWidth="150.0" text="Lượt quan tâm" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>

            </children>
        </VBox>
    </children>
</AnchorPane>