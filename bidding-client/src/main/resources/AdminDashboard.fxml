<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uet.bidding.controller.AdminDashboardController">
    <left>
        <VBox prefHeight="600.0" prefWidth="240.0" style="-fx-background-color: #1e3799;" BorderPane.alignment="CENTER">
            <children>
                <Label text="ADMIN PANEL" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="40.0" left="30.0" top="30.0" />
                    </VBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleManageUsers" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="👤 Quản lý Người dùng">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleManageItems" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="📦 Phê duyệt Sản phẩm">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleSystemReports" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="📊 Thống kê Hệ thống">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <VBox VBox.vgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: #eb2f06; -fx-text-fill: white; -fx-cursor: hand;" text="Đăng xuất">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f1f2f6;" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <Label text="THỐNG KÊ HỆ THỐNG" textFill="#1e3799">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <HBox spacing="20.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="140.0" prefWidth="200.0" style="-fx-background-color: #3c6382; -fx-background-radius: 10;">
                                    <children>
                                        <Label text="TỔNG NGƯỜI DÙNG" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTotalUsers" text="0" textFill="#00d2d3">
                                            <font>
                                                <Font name="System Bold" size="40.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="140.0" prefWidth="200.0" style="-fx-background-color: #3c6382; -fx-background-radius: 10;">
                                    <children>
                                        <Label text="PHIÊN ĐANG MỞ" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblActiveSessions" text="0" textFill="#ff9f43">
                                            <font>
                                                <Font name="System Bold" size="40.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="140.0" prefWidth="200.0" style="-fx-background-color: #3c6382; -fx-background-radius: 10;">
                                    <children>
                                        <Label text="SP CHỜ DUYỆT" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblPendingItems" text="0" textFill="#ee5253">
                                            <font>
                                                <Font name="System Bold" size="40.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>