<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="640.0" style="-fx-background-color: #ffe6ea;"
            stylesheets="@style.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uet.bidding.controller.ProductDetailController">
    <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: white; -fx-border-color: #fd79a8; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0"/>
            </padding>
            <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: bold;"
                    text="← Quay lại" textFill="#e84393"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label style="-fx-font-weight: bold; -fx-font-size: 17px;" text="CHI TIẾT PHIÊN ĐẤU GIÁ" textFill="#e84393"/>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="16.0">
                <padding>
                    <Insets bottom="16.0" left="20.0" right="20.0" top="12.0"/>
                </padding>

                <!-- Product -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #fd79a8; -fx-border-radius: 12;">
                    <StackPane>
                        <ImageView fx:id="imgProduct" fitHeight="220.0" fitWidth="360.0" preserveRatio="true"/>
                        <Label text="LIVE" StackPane.alignment="TOP_LEFT"
                               style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 5;">
                            <StackPane.margin>
                                <Insets left="8.0" top="8.0"/>
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label fx:id="lblProductName" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e84393;" wrapText="true"/>
                    <HBox spacing="8.0">
                        <Label text="● Đang diễn ra" style="-fx-text-fill: #e84393; -fx-font-weight: bold;"/>
                        <Label text="|" style="-fx-text-fill: #fd79a8;"/>
                        <Label fx:id="lblAuctionId" style="-fx-text-fill: #64748b;"/>
                    </HBox>
                    <HBox spacing="20.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Giá cao nhất" style="-fx-text-fill: #64748b;"/>
                            <Label fx:id="lblCurrentPrice" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblHighestBidder" style="-fx-text-fill: #e84393; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="TOP_RIGHT" spacing="4.0">
                            <Label text="Còn lại" style="-fx-text-fill: #64748b;"/>
                            <Label fx:id="lblCountdown" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ff4757;"/>
                        </VBox>
                    </HBox>
                    <Label text="Mô tả" style="-fx-font-weight: bold; -fx-text-fill: #e84393;"/>
                    <Label fx:id="lblDescription" wrapText="true" style="-fx-text-fill: #475569;"/>
                    <Label fx:id="lblAntiSnipeInfo" wrapText="true"
                           text="⏱ Đặt giá trong 2 phút cuối → gia hạn thêm 5 phút"
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Registration -->
                <VBox spacing="8.0" style="-fx-background-color: #fff5f7; -fx-padding: 14; -fx-background-radius: 10; -fx-border-color: #fd79a8; -fx-border-radius: 10;">
                    <Label text="Đăng ký tham gia" style="-fx-font-weight: bold; -fx-text-fill: #e84393;"/>
                    <Label fx:id="lblRegisterHint" wrapText="true" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                    <HBox spacing="10.0">
                        <Button fx:id="btnRegister" onAction="#handleRegister" prefHeight="38.0"
                                style="-fx-background-color: #e84393; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Đăng ký"/>
                        <Label fx:id="lblRegisteredCount" style="-fx-text-fill: #64748b;"/>
                    </HBox>
                </VBox>

                <!-- Place bid -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10; -fx-border-color: #fd79a8; -fx-border-radius: 10;">
                    <Label text="Đặt giá" style="-fx-font-weight: bold; -fx-text-fill: #e84393;"/>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..." HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblMinBid" style="-fx-text-fill: #94a3b8;"/>
                    </HBox>
                    <HBox spacing="10.0">
                        <Button onAction="#handlePlaceBid" text="ĐẶT GIÁ" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #e84393; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        <Button onAction="#handleBuyNow" text="MUA NGAY" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Auto-bid -->
                <VBox spacing="8.0" style="-fx-background-color: #fff5f7; -fx-padding: 14; -fx-background-radius: 10; -fx-border-color: #fd79a8; -fx-border-radius: 10;">
                    <Label text="Đấu giá tự động" style="-fx-font-weight: bold; -fx-text-fill: #e84393;"/>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Trần giá:" style="-fx-text-fill: #64748b;"/>
                        <TextField fx:id="txtMaxAutoBid" promptText="VD: 5000000" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10.0">
                        <Button fx:id="btnEnableAutoBid" onAction="#handleEnableAutoBid" text="Bật Auto-Bid" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #e84393; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

                        <Button fx:id="btnDisableAutoBid" onAction="#handleDisableAutoBid" text="Tắt Auto-Bid" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #f31313; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- History -->
                <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10; -fx-border-color: #fd79a8; -fx-border-radius: 10;">
                    <Label text="Lịch sử đặt giá" style="-fx-font-weight: bold; -fx-text-fill: #e84393;"/>
                    <TableView fx:id="bidHistoryTable" prefHeight="140.0">
                        <columns>
                            <TableColumn fx:id="colBidTime" prefWidth="180.0" text="Thời gian"/>
                            <TableColumn fx:id="colBidAmount" prefWidth="150.0" text="Số tiền (VNĐ)"/>
                        </columns>
                    </TableView>
                    <LineChart fx:id="bidLineChart" prefHeight="180.0" legendVisible="false">
                        <xAxis>
                            <CategoryAxis label="Thời gian"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Giá (VNĐ)"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
