<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.ui.AuctionListController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="VNU" textFill="#555555">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-cursor: hand;" text="Đăng nhập/đăng kí" textFill="#555555">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Circle fill="WHITE" radius="15.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="2.0" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>

                <Label text="Danh sách sản phẩm đấu giá" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <TextField fx:id="txtCity" prefWidth="180.0" promptText="Thành Phố 🔍" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: black; -fx-border-width: 2;" />
                        <TextField fx:id="txtBudget" prefWidth="180.0" promptText="Số tiền hiện có 🔍" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: black; -fx-border-width: 2;" />
                        <TextField fx:id="txtProduct" prefWidth="180.0" promptText="Sản phẩm cần tìm 🔍" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: black; -fx-border-width: 2;" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefWidth="120.0" style="-fx-background-color: #ffcccc; -fx-border-color: #33cc33; -fx-border-radius: 15; -fx-background-radius: 15; -fx-border-width: 2; -fx-text-fill: #555555; -fx-cursor: hand;" text="TÌM KIẾM">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox style="-fx-border-color: black; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableView" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colStt" prefWidth="60.0" style="-fx-alignment: CENTER;" text="STT" />
                                <TableColumn fx:id="colCity" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Thành Phố/Tỉnh" />
                                <TableColumn fx:id="colProduct" prefWidth="250.0" style="-fx-alignment: CENTER;" text="Loại sản phẩm" />
                                <TableColumn fx:id="colInterested" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Số người quan tâm" />
                                <TableColumn fx:id="colAction" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Lựa chọn" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>