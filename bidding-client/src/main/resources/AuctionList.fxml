<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/19" fx:controller="com.uet.bidding.controller.AuctionListController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="title-label" text="DANH SÁCH ĐẤU GIÁ" textFill="#d8466b">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>

                                <VBox alignment="CENTER" onMouseClicked="#handleGoToMyProfile" spacing="4.0"
                                      style="-fx-cursor: hand;">
                                    <children>
                                        <Circle fill="#e2e8f0" radius="20.0" stroke="#cbd5e1" strokeType="INSIDE"/>
                                        <Label text="My Profile" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="12.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <Button mnemonicParsing="false" onAction="#handleLogout"
                                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 100px; -fx-pref-height: 35px;"
                                        styleClass="action-button" text="Đăng xuất">
                                    <font>
                                        <Font name="System Bold" size="13.0"/>
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <ComboBox fx:id="cityComboBox" prefHeight="42.0" prefWidth="300.0"
                                  promptText="Chọn Tỉnh/Thành phố..." styleClass="input-field"
                                  style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
                        <Button mnemonicParsing="false" onAction="#handleSearch"
                                style="-fx-background-color: #f26f8d; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-height: 42px; -fx-pref-width: 110px;"
                                styleClass="action-button" text="Tìm kiếm">
                            <font>
                                <Font name="System Bold" size="14.0"/>
                            </font>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="tableView" prefHeight="380.0" prefWidth="860.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colStt" prefWidth="70.0" text="STT"/>
                        <TableColumn fx:id="colCity" prefWidth="180.0" text="Thành Phố/Tỉnh"/>
                        <TableColumn fx:id="colProduct" prefWidth="300.0" text="Loại sản phẩm"/>
                        <TableColumn fx:id="colInterested" prefWidth="160.0" text="Số người quan tâm"/>
                        <TableColumn fx:id="colAction" prefWidth="148.0" text="Lựa chọn"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" prefHeight="50.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleGoToMyManagement"
                                style="-fx-background-color: #f26f8d; -fx-text-fill: white; -fx-background-radius: 20; -fx-pref-height: 45px; -fx-pref-width: 180px;"
                                text="Quản lí của tôi">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>