<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="600.0"
            prefWidth="900.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.uet.bidding.controller.AuctionListController">

    <children>

        <VBox spacing="15.0"
              alignment="TOP_CENTER"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">

            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER"
                      prefWidth="860.0">

                    <children>

                        <!-- Nút bidder hình tròn góc trái -->
                        <VBox alignment="CENTER"
                              spacing="4.0"
                              onMouseClicked="#handleGoToMyManagement"
                              style="-fx-cursor: hand;">

                            <children>

                                <StackPane prefWidth="60.0"
                                           prefHeight="60.0">

                                    <children>
                                        <Circle radius="28.0"
                                                fill="#f26f8d"/>

                                        <Label text="👤"
                                               textFill="white">
                                            <font>
                                                <Font size="22.0"/>
                                            </font>
                                        </Label>
                                    </children>

                                </StackPane>

                                <Label text="Bidder"
                                       textFill="#555555">
                                    <font>
                                        <Font name="System Bold"
                                              size="13.0"/>
                                    </font>
                                </Label>

                            </children>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Title căn giữa -->
                        <Label text="DANH SÁCH ĐẤU GIÁ"
                               styleClass="title-label"
                               textFill="#1e3a8a">

                            <font>
                                <Font name="System Bold"
                                      size="30.0"/>
                            </font>

                        </Label>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Setting + logout -->
                        <HBox alignment="CENTER"
                              spacing="20.0">

                            <children>

                                <VBox alignment="CENTER"
                                      spacing="4.0"
                                      onMouseClicked="#handleGoToMyProfile"
                                      style="-fx-cursor: hand;">

                                    <children>

                                        <Circle fill="#e2e8f0"
                                                radius="20.0"
                                                stroke="#cbd5e1"
                                                strokeType="INSIDE"/>

                                        <Label text="Setting"
                                               textFill="#555555">

                                            <font>
                                                <Font name="System Bold"
                                                      size="12.0"/>
                                            </font>

                                        </Label>

                                    </children>

                                </VBox>

                                <Button text="Đăng xuất"
                                        mnemonicParsing="false"
                                        onAction="#handleLogout"
                                        style="-fx-background-color: #ef4444;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-pref-width: 110px;
                                               -fx-pref-height: 38px;">

                                    <font>
                                        <Font name="System Bold"
                                              size="13.0"/>
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </HBox>

                <!-- Search -->
                <HBox spacing="10.0"
                      alignment="CENTER_LEFT">

                    <children>

                        <ComboBox fx:id="cityComboBox"
                                  prefHeight="42.0"
                                  prefWidth="300.0"
                                  promptText="Chọn Tỉnh/Thành phố..."
                                  style="-fx-background-radius: 8;
                                         -fx-border-radius: 8;"/>

                        <Button text="Tìm kiếm"
                                mnemonicParsing="false"
                                onAction="#handleSearch"
                                style="-fx-background-color: #f26f8d;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;
                                       -fx-pref-height: 42px;
                                       -fx-pref-width: 120px;">

                            <font>
                                <Font name="System Bold"
                                      size="14.0"/>
                            </font>

                        </Button>

                    </children>

                </HBox>

                <!-- TABLE -->
                <TableView fx:id="tableView"
                           prefHeight="320.0"
                           prefWidth="860.0">

                    <columns>

                        <TableColumn fx:id="colStt"
                                     text="STT"/>

                        <TableColumn fx:id="colCity"
                                     text="Thành Phố/Tỉnh"/>

                        <TableColumn fx:id="colProduct"
                                     text="Loại sản phẩm"/>

                        <TableColumn fx:id="colInterested"
                                     text="Số người quan tâm"/>

                        <TableColumn fx:id="colAction"
                                     text="Lựa chọn"/>

                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</AnchorPane>