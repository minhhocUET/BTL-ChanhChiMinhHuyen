<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="com.uet.bidding.controller.admin.AdminItemManagementController"
      prefHeight="600.0" prefWidth="660.0" spacing="15.0" style="-fx-background-color: #ffffff;">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>
        <VBox spacing="5.0">
            <children>
                <Label text="PHÊ DUYỆT SẢN PHẨM" textFill="#1b3394">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0"/>
                    </font>
                </Label>
                <Label text="Sản phẩm do Seller đăng cần được duyệt trước khi chính thức lên sàn đấu giá."
                       textFill="#7f8c8d">
                    <font>
                        <Font name="Segoe UI" size="14.0"/>
                    </font>
                </Label>
            </children>
        </VBox>

        <TableView fx:id="tablePendingItems" prefHeight="450.0" prefWidth="620.0" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #e2e8f0; -fx-border-radius: 4; -fx-font-family: 'Segoe UI';">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colName" prefWidth="240.0" text="Tên Sản phẩm" style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colSellerId" prefWidth="140.0" text="Mã Người bán" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colPrice" prefWidth="160.0" text="Giá khởi điểm"
                             style="-fx-alignment: CENTER-RIGHT; -fx-padding: 0 15 0 0;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleRejectAction" prefHeight="38.0" prefWidth="130.0"
                        style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Từ chối">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Button>

                <Button mnemonicParsing="false" onAction="#handleApproveAction" prefHeight="38.0" prefWidth="130.0"
                        style="-fx-background-color: #2ed573; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Phê duyệt">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>