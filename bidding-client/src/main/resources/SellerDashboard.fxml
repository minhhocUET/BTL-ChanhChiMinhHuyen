<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #fce4ec;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.controller.SellerDashboardController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <StackPane prefHeight="60.0" prefWidth="60.0">
                            <children>
                                <Circle fill="#e91e63" radius="28.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />
                                <Label fx:id="avatarLabel" text="S" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="⬅ Quay lại" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="SELLER DASHBOARD" textFill="#880e4f">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAddProduct" style="-fx-background-color: #e91e63; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20 10 20;" text="➕ Đăng sản phẩm mới" />
                        <Button mnemonicParsing="false" onAction="#handleViewReview" style="-fx-background-color: #0288d1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20 10 20;" text="💬 Xem đánh giá của khách hàng" />
                    </children>
                </HBox>

                <Separator prefWidth="200.0" />

                <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #f8bbd0; -fx-border-radius: 12; -fx-border-width: 1.5;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Tên cửa hàng:">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="storeNameField" prefWidth="300.0" promptText="Nhập tên shop..." style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #c2185b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #f8bbd0; -fx-background-color: transparent;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="⭐" />
                                <Label fx:id="ratingLabel" text="0.0" textFill="#f57f00">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555555;" text="Mô tả Shop:" />
                        <TextArea fx:id="descriptionArea" prefHeight="80.0" promptText="Nhập mô tả shop của bạn..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #f8bbd0; -fx-background-color: transparent;" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleSaveInfo" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 18 8 18;" text="💾 Lưu thông tin" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Separator prefWidth="200.0" />

                <TabPane fx:id="sellerTabPane" prefHeight="320.0" style="-fx-background-color: white;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="📦 Kho hàng">
                            <content>
                                <TableView fx:id="inventoryTable" prefHeight="280.0">
                                    <columns>
                                        <TableColumn fx:id="invColId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="invColName" prefWidth="250.0" text="Tên sản phẩm" />
                                        <TableColumn fx:id="invColType" prefWidth="100.0" text="Loại" />
                                        <TableColumn fx:id="invColCity" prefWidth="200.0" text="Thành phố" />
                                        <TableColumn fx:id="invColPrice" prefWidth="120.0" text="Giá khởi điểm" />
                                        <TableColumn fx:id="invColStatus" prefWidth="150.0" text="Trạng thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </content>
                        </Tab>
                        <Tab text="Phiên đấu giá đang diễn ra">
                            <content>
                                <TableView fx:id="activeAuctionsTable" prefHeight="280.0">
                                    <columns>
                                        <TableColumn fx:id="activeColCity" prefWidth="180.0" text="Thành phố" />
                                        <TableColumn fx:id="activeColType" prefWidth="150.0" text="Loại" />
                                        <TableColumn fx:id="activeColName" prefWidth="280.0" text="Tên sản phẩm" />
                                        <TableColumn fx:id="activeColPrice" prefWidth="120.0" text="Giá hiện tại" />
                                    </columns>
                                </TableView>
                            </content>
                        </Tab>
                        <Tab text="Phiên đấu giá đã kết thúc">
                            <content>
                                <TableView fx:id="finishedAuctionsTable" prefHeight="280.0">
                                    <columns>
                                        <TableColumn fx:id="finishedColCity" prefWidth="180.0" text="Thành phố" />
                                        <TableColumn fx:id="finishedColType" prefWidth="150.0" text="Loại" />
                                        <TableColumn fx:id="finishedColName" prefWidth="280.0" text="Tên sản phẩm" />
                                        <TableColumn fx:id="finishedColPrice" prefWidth="120.0" text="Giá cuối" />
                                    </columns>
                                </TableView>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

            </children>
        </VBox>
    </children>
</AnchorPane>
