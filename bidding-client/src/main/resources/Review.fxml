<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: #fce4ec;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.controller.ReviewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 18; -fx-border-color: #f8bbd0; -fx-border-radius: 18; -fx-border-width: 1.5;">
                    <children>
                        <StackPane prefHeight="70.0" prefWidth="70.0">
                            <children>
                                <Circle fill="#ffe4ec" radius="35.0" stroke="#ffb3cc" strokeType="INSIDE" />
                                <Label fx:id="reviewAvatarLabel" style="-fx-font-size: 32px; -fx-font-weight: bold;" text="?" textFill="#e91e63" />
                                <ImageView fx:id="reviewAvatarImageView" fitHeight="70.0" fitWidth="70.0" preserveRatio="true" smooth="true" />
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label fx:id="lblShopName" text="Pink Shop" textFill="#880e4f">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>

                                <Label fx:id="lblShopDescription" text="Đang tải mô tả cửa hàng..." textFill="#ad1457" wrapText="true">
                                    <font>
                                        <Font name="System Italic" size="14.0" />
                                    </font>
                                </Label>

                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <children>
                                        <Label fx:id="lblAvgRating" style="-fx-font-weight: bold; -fx-font-size: 18px;" text="0.0" textFill="#c2185b" />
                                        <Label style="-fx-font-size: 16px;" text="⭐⭐⭐⭐★" textFill="#ffb300" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblReviewCount" text="(0 đánh giá)" textFill="#888888">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <ImageView fitHeight="114.0" fitWidth="119.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@anya.png" />
                            </image>
                        </ImageView>

                        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="150.0" style="-fx-background-color: #fdf2f4; -fx-border-color: #ffb3cc; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10;">
                            <children>
                                <Label text="Đánh giá trung bình" textFill="#880e4f">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="2.0">
                                    <children>
                                        <Label fx:id="lblBigAvgRating" text="0.0" textFill="#c2185b">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label text=" / 5" textFill="#888888">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="reviewsContainer" spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 5 5 5 5;" />
                    </content>
                </ScrollPane>

                <VBox fx:id="addReviewBox" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #f8bbd0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #880e4f;" text="Viết đánh giá của bạn" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Số sao:" />
                            <ComboBox fx:id="cmbStars" prefWidth="120.0" />
                        </HBox>
                        <TextArea fx:id="txtReviewComment" prefRowCount="3" promptText="Nhập nội dung..." wrapText="true" />
                        <Button onAction="#handleSubmitReview" style="-fx-background-color: #e91e63; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Gửi đánh giá" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBackToAuctionList" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #fdf2f4; -fx-text-fill: #e91e63; -fx-border-color: #e91e63; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="📋 Danh sách đấu giá" />

                        <Button fx:id="btnBackToManagement" mnemonicParsing="false" onAction="#handleBackToManagement" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #ffffff; -fx-text-fill: #e91e63; -fx-border-color: #e91e63; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="⬅ Quay lại" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
