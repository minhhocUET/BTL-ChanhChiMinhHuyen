<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<HBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #ffffff;"
      xmlns="http://javafx.com/javafx/21" fx:controller="com.uet.bidding.controller.admin.AdminDashboardController">
    <children>

        <VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="240.0" spacing="12.0"
              style="-fx-background-color: #1b3394;" HBox.hgrow="NEVER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0"/>
            </padding>
            <children>
                <Label text="ADMIN PANEL" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="25.0"/>
                    </VBox.margin>
                </Label>

                <Button fx:id="btnOverview" alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#showOverviewPage" prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;"
                        text="📊  Tổng quan">
                    <padding>
                        <Insets left="20.0"/>
                    </padding>
                </Button>

                <Button fx:id="btnUserManagement" alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#showUserManagementPage" prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;"
                        text="👤  Quản lý Người dùng">
                    <padding>
                        <Insets left="20.0"/>
                    </padding>
                </Button>

                <Button fx:id="btnItemApproval" alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#showItemApprovalPage" prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;"
                        text="🎁  Phê duyệt Sản phẩm">
                    <padding>
                        <Insets left="20.0"/>
                    </padding>
                </Button>

                <Button fx:id="btnAuctionManagement" alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#showAuctionManagementPage" prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;"
                        text="⚖️  Quản lý Phiên đấu giá">
                    <padding>
                        <Insets left="20.0"/>
                    </padding>
                </Button>

                <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnLogout" onAction="#handleLogout" mnemonicParsing="false" prefHeight="40.0"
                                prefWidth="210.0"
                                style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="Đăng xuất"/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <StackPane fx:id="contentArea" prefHeight="650.0" prefWidth="710.0" style="-fx-background-color: #ffffff;"
                   HBox.hgrow="ALWAYS"/>

    </children>
</HBox>