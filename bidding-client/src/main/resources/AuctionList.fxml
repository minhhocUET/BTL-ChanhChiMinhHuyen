<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.bidding.controller.auction.AuctionListController">

    <children>

        <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <children>

                <HBox alignment="CENTER" prefWidth="860.0">

                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <StackPane onMouseClicked="#handleGoToMyManagement" prefHeight="60.0" prefWidth="60.0" style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#f26f8d" radius="28.0" />
                                                <Label text="B" textFill="white">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Bidder" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <StackPane onMouseClicked="#handleGoToSellerDashboard" prefHeight="60.0" prefWidth="60.0" style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="#3b82f6" radius="28.0" />
                                                <Label text="S" textFill="white">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label text="Seller" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="DANH SÁCH ĐẤU GIÁ" textFill="#1e3a8a">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="20.0">

                            <children>

                                <VBox alignment="CENTER" onMouseClicked="#handleGoToMyProfile" spacing="4.0" style="-fx-cursor: hand;">
                                    <children>
                                        <Label style="-fx-font-size: 28px; -fx-background-color: #e2e8f0; -fx-background-radius: 50; -fx-padding: 6 10 6 10;" text="👤" />
                                        <Label text="Hồ sơ" textFill="#555555">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <StackPane>
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-width: 110px; -fx-pref-height: 38px;" text="Đăng xuất">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Button>

                                        <ImageView fitHeight="84.0" fitWidth="70.0" preserveRatio="true" translateX="-45.0">
                                            <image>
                                                <Image url="@bakugo.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>

                            </children>

                        </HBox>

                    </children>

                </HBox>

                <Pane prefHeight="26.0" prefWidth="860.0">
                    <children>
                        <ImageView fitHeight="120.0" fitWidth="231.0" layoutX="0.0" layoutY="-40.0" managed="false" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@saitama.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>

                <TableView fx:id="tableView" prefWidth="860.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCity" maxWidth="130.0" minWidth="130.0" prefWidth="130.0" resizable="false" text="Thành phố" />
                        <TableColumn fx:id="colItemType" maxWidth="130.0" minWidth="130.0" prefWidth="130.0" resizable="false" text="Loại sản phẩm" />
                        <TableColumn fx:id="colProductName" prefWidth="290.0" resizable="false" text="Tên sản phẩm" />
                        <TableColumn fx:id="colRegistered" maxWidth="160.0" minWidth="160.0" prefWidth="160.0" resizable="false" text="Số người đăng ký" />
                        <TableColumn fx:id="colAction" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" resizable="false" text="Thao tác" />
                    </columns>
                </TableView>

            </children>

        </VBox>

        <ImageView fitHeight="127.0" fitWidth="110.0" layoutX="776.0" layoutY="462.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="14.25" AnchorPane.rightAnchor="14.0">
            <image>
                <Image url="@chopper.png" />
            </image>
        </ImageView>

    </children>

</AnchorPane>
